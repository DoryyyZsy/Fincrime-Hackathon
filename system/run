#!/usr/bin/env python3
"""Screening hit adjudication: system/run <data folder> <output file>

Reads only <data folder> (JSON Lines, dev or unseen format) and writes one JSON line per hit.
Python 3 standard library only, no network, no LLM. Deterministic: the same input gives the same file.
"""
import json
import os
import sys
import time

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
sys.path.insert(0, ROOT)

try:  # the SOP engine lives in screening_ml/ next to system/ (stdlib-only modules)
    from screening_ml.compare import decide_case
    from screening_ml.customer import resolve
    from screening_ml.data import DataRoom
    from screening_ml.hit import build_hit
except ImportError as error:
    sys.exit(f"cannot import the engine from {ROOT}/screening_ml: {error}")


def fallback(hit, alert_id, why, resolution=None):
    """Never crash and never clear on unexpected data: send the hit to a person."""
    record = None
    if resolution is not None and resolution.persons:
        record = "AMBIGUOUS" if len(resolution.persons) > 1 else resolution.persons[0].primary
    return {
        "hit_id": hit["hit_id"], "alert_id": alert_id, "decision": "REVIEW", "reason_code": "INSUFFICIENT_DATA",
        "customer_record_id": record,
        "reason": f"The system could not evaluate this hit automatically ({why}), so a person must review it.",
        "evidence": [],
    }


def main(argv):
    if len(argv) != 3:
        sys.exit("usage: system/run <data folder> <output file>")
    folder, out_path = argv[1], argv[2]
    t0 = time.time()
    room = DataRoom(folder)

    rows, errors = [], 0
    resolutions = {}
    for hit in room.hits:  # every hit gets exactly one line, in hits.jsonl order
        alert = room.alert_by_id.get(hit.get("alert_id"))
        if alert is None:
            rows.append(fallback(hit, hit.get("alert_id"), "its alert is missing"))
            errors += 1
            continue
        try:
            if alert["alert_id"] not in resolutions:
                resolutions[alert["alert_id"]] = resolve(room, alert)
            case = decide_case(resolutions[alert["alert_id"]], build_hit(room, hit), alert)
            rows.append({
                "hit_id": case.hit_id, "alert_id": case.alert_id, "decision": case.teacher_decision,
                "reason_code": case.teacher_code, "customer_record_id": case.customer_record_id,
                "reason": case.teacher_reason, "evidence": case.teacher_evidence,
            })
        except Exception as error:  # robustness on unseen data beats a crash
            rows.append(fallback(hit, alert["alert_id"], type(error).__name__, resolutions.get(alert["alert_id"])))
            errors += 1

    os.makedirs(os.path.dirname(os.path.abspath(out_path)), exist_ok=True)
    with open(out_path, "w", encoding="utf-8", newline="\n") as handle:
        for row in rows:
            handle.write(json.dumps(row, ensure_ascii=False, sort_keys=False) + "\n")

    counts = {}
    for row in rows:
        counts[row["decision"]] = counts.get(row["decision"], 0) + 1
    print(f"wrote {len(rows)} lines to {out_path} in {time.time() - t0:.1f}s: {counts}"
          + (f"; {errors} hits fell back to REVIEW after an error" if errors else ""), file=sys.stderr)


if __name__ == "__main__":
    main(sys.argv)
